{
  "name": "rag-eval-harness",
  "version": "0.1.0",
  "description": "LLM-judge evaluation harness for RAG pipelines: faithfulness, answer relevance, context precision, context recall.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "rag-eval": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "eval": "tsx src/cli.ts",
    "eval:fake": "tsx src/cli.ts --judge fake",
    "render:docs": "tsx src/cli.ts --judge fake --dataset data/sample-dataset.json --out docs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "openai": "^4.68.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.2"
  },
  "engines": {
    "node": ">=20"
  }
}
